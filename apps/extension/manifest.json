{
  "manifest_version": 3,
  "name": "Local PDF Editor · Preview",
  "version": "0.1.0",
  "description": "Open and inspect PDFs on your device. Editing is not available in this preview.",
  "action": { "default_title": "Open Local PDF Editor" },
  "background": { "service_worker": "background.js" },
  "content_security_policy": { "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'none'; connect-src 'self'; worker-src 'self';" }
}
